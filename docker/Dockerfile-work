FROM nvidia/cuda:12.8.0-devel-ubuntu22.04
LABEL name="hunyuan3d21" maintainer="hunyuan3d21"

# Workspace vorbereiten
RUN mkdir -p /workspace
WORKDIR /workspace

# Systempakete installieren
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    wget \
    vim \
    libegl1-mesa-dev \
    libglib2.0-0 \
    unzip \
    git-lfs \
    pkg-config \
    libglvnd0 \
    libgl1 \
    libglx0 \
    libegl1 \
    libgles2 \
    libglvnd-dev \
    libgl1-mesa-dev \
    libegl1-mesa-dev \
    libgles2-mesa-dev \
    cmake \
    curl \
    mesa-utils-extra \
    libxrender1 \
    libeigen3-dev \
    python3-dev \
    python3-setuptools \
    libcgal-dev \
    libxi6 \
    libgconf-2-4 \
    libxkbcommon-x11-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Python-Umgebung konfigurieren
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV LD_LIBRARY_PATH=/usr/lib64:$LD_LIBRARY_PATH
ENV PYOPENGL_PLATFORM=egl
ENV TORCH_CUDA_ARCH_LIST="6.0;6.1;7.0;7.5;8.0;8.6;8.9;9.0;12.0"

# CUDA-Konfiguration (automatisch aus Basis-Image)
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

# Miniconda installieren
RUN wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh && \
    chmod +x Miniconda3-latest-Linux-x86_64.sh && \
    ./Miniconda3-latest-Linux-x86_64.sh -b -p /workspace/miniconda3 && \
    rm Miniconda3-latest-Linux-x86_64.sh

ENV PATH="/workspace/miniconda3/bin:${PATH}"
RUN conda init bash
RUN conda tos accept

# Conda-Umgebung erstellen
RUN conda create -n hunyuan3d21 python=3.10 -y
ENV PATH="/workspace/miniconda3/envs/hunyuan3d21/bin:${PATH}"

# Grundlegende Abhängigkeiten
RUN conda install -y ninja
RUN conda install -y -c conda-forge libstdcxx-ng

# CUDA-Paket aus Conda nicht installieren - stattdessen System-CUDA verwenden
# PyTorch direkt mit CUDA 12.8 installieren
RUN pip install torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu128

# Repository klonen
RUN git clone https://github.com/Tencent-Hunyuan/Hunyuan3D-2.1.git
COPY requirements.txt Hunyuan3D-2.1/requirements.txt
RUN pip install -r Hunyuan3D-2.1/requirements.txt

# Custom-Renderer mit CUDA 12.8 Flags kompilieren
RUN cd /workspace/Hunyuan3D-2.1/hy3dpaint/custom_rasterizer && \
    export TORCH_CUDA_ARCH_LIST="6.0;6.1;7.0;7.5;8.0;8.6;8.9;9.0;12.0" && \
    export CUDA_NVCC_FLAGS="-allow-unsupported-compiler" && \
    python setup.py install

# DifferentiableRenderer kompilieren
RUN cd /workspace/Hunyuan3D-2.1/hy3dpaint/DifferentiableRenderer && \
    bash compile_mesh_painter.sh

# RealESRGAN Modell downloaden
RUN cd /workspace/Hunyuan3D-2.1/hy3dpaint && \
    mkdir -p ckpt && \
    wget https://github.com/xinntao/Real-ESRGAN/releases/download/v0.1.0/RealESRGAN_x4plus.pth -P ckpt

# Korrigiere Dateipfade in den Python-Skripten
RUN cd /workspace/Hunyuan3D-2.1/hy3dpaint && \
    sed -i 's/self\.multiview_cfg_path = "cfgs\/hunyuan-paint-pbr\.yaml"/self.multiview_cfg_path = "hy3dpaint\/cfgs\/hunyuan-paint-pbr.yaml"/' textureGenPipeline.py

RUN cd /workspace/Hunyuan3D-2.1/hy3dpaint/utils && \
    sed -i 's/custom_pipeline = config\.custom_pipeline/custom_pipeline = os.path.join(os.path.dirname(__file__),"..","hunyuanpaintpbr")/' multiview_utils.py

# Abschließende Konfiguration
WORKDIR /workspace/Hunyuan3D-2.1
ENV LD_LIBRARY_PATH="/workspace/miniconda3/envs/hunyuan3d21/lib:${LD_LIBRARY_PATH}"

# Conda-Umgebung permanent aktivieren
RUN echo "conda activate hunyuan3d21" >> ~/.bashrc
SHELL ["/bin/bash", "--login", "-c"]

# Gradio-Cache
RUN mkdir gradio_cache
EXPOSE 7860
CMD ["python", "api_server.py"]
